pub struct LibraryConstant {
    slot: &'static AtomicPtr<LeanObject>,
    path: &'static [&'static str],
}

impl LibraryConstant {
    #[inline]
    pub unsafe fn obj(self) -> *mut LeanObject {
        let cached = self.slot.load(Ordering::Acquire);
        if !cached.is_null() {
            return cached;
        }

        let name = mk_name_path(self.path);
        lean_mark_persistent(name.obj);
        let obj = name.obj;

        match self
            .slot
            .compare_exchange(ptr::null_mut(), obj, Ordering::AcqRel, Ordering::Acquire)
        {
            Ok(_) => obj,
            Err(existing) => {
                lean_dec(obj);
                existing
            }
        }
    }
}

macro_rules! library_constant_const {
    ($slot:ident, $name:ident, [$($component:expr),+ $(,)?]) => {
        static $slot: AtomicPtr<LeanObject> = AtomicPtr::new(ptr::null_mut());
        pub const $name: LibraryConstant = LibraryConstant {
            slot: &$slot,
            path: &[$($component),+],
        };
    };
}

